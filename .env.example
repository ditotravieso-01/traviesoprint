# TraviesoPrint — Plantilla de variables de entorno
# Copiar a .env y rellenar los valores reales:
#   cp .env.example .env
# El .env real NO se sube a git.

# ===== Básico =====
SECRET_KEY=cambiar-por-clave-aleatoria-larga
DATABASE_URL=sqlite:////ruta/a/instance/traviesoprint.db
FLASK_APP=app:create_app
FLASK_DEBUG=False
FLASK_ENV=production

# ===== Rutas =====
UPLOAD_FOLDER=/ruta/a/app/static/uploads
LOG_FOLDER=/ruta/a/logs

# ===== LDAP / Active Directory =====
LDAP_ENABLED=True
LDAP_SERVER=dc1.dominio.local
LDAP_PORT=636
LDAP_USE_SSL=True
LDAP_BASE_DN=DC=dominio,DC=local
LDAP_DOMAIN=dominio.local
LDAP_SERVICE_USER=print@dominio.local
LDAP_SERVICE_PASSWORD=cambiar-por-password-real
LDAP_TIMEOUT=5
LDAP_CA_CERTS=/etc/ssl/certs/ca-certificates.crt

# ===== Odoo API =====
ODOO_ENABLED=False
ODOO_URL=https://odoo.dominio.local
ODOO_DB=db_odoo
ODOO_USER=sync_user@dominio.local
ODOO_PASSWORD=cambiar-por-api-key-de-odoo
ODOO_UID=<el número que obtuviste de Odoo>
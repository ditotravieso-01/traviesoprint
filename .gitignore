*.log
logs/
tmp/
temp/
*.tmp

# ============================================================
# Uploads generados en runtime — NO versionar
# ============================================================
# Favoritos: ignorar todo menos el .gitkeep y su carpeta _blobs
app/static/uploads/favoritos/*
!app/static/uploads/favoritos/.gitkeep
!app/static/uploads/favoritos/_blobs/
app/static/uploads/favoritos/_blobs/*
!app/static/uploads/favoritos/_blobs/.gitkeep

# Órdenes: ignorar todo menos el .gitkeep
app/static/uploads/ordenes/*
!app/static/uploads/ordenes/.gitkeep

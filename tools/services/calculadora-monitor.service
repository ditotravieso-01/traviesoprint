[Unit]
Description=Monitor de calculadoras CairostudioKit
After=network.target calculadora.service lona-calculadora.service

[Service]
User=cairokit
Group=cairokit
WorkingDirectory=/opt/cairokit/monitor
ExecStart=/usr/bin/python3 /opt/cairokit/monitor/monitor.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
[Unit]
Description=Monitor de calculadoras Cairostudiokit
After=network.target calculadora.service lona-calculadora.service

[Service]
User=cairostudiokit
Group=cairostudiokit
WorkingDirectory=/opt/cairostudiokit/monitor
ExecStart=/usr/bin/python3 /opt/cairostudiokit/monitor/monitor.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target